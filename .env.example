# Signs the login cookie. Required in production. Use a long random string (32+ characters).
DOCS_SESSION_SECRET=

# PostgreSQL connection for developer accounts. Create the table with db/developers.sql first.
# Without it (local development only) accounts are kept in .data/developers.json.
DATABASE_URL=

# Public address of the site, used to build the link in the verification email.
SITE_URL=https://sabbpe.com

# SMTP settings for the verification email. Without SMTP_HOST the link is printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SabbPe <no-reply@sabbpe.com>
